<?xml version="1.0" encoding="UTF-8"?>
<!-- Fluxo de venda organizado por entrada, carrinho e recebimento. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.loja.pdv.controller.VendaController" styleClass="page-shell">
    <VBox styleClass="page-header">
        <Label text="Nova venda" styleClass="page-title"/>
        <Label text="Adicione os produtos, confira os valores e finalize o recebimento."
               styleClass="page-subtitle"/>
    </VBox>
    <Label fx:id="mensagemLabel" wrapText="true" styleClass="feedback"/>
    <!-- Coluna principal controla produtos; coluna lateral resume e recebe. -->
    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <!-- Entrada rapida por codigo ou pesquisa no catalogo. -->
            <VBox styleClass="card, card-compact">
                <Label text="Adicionar produto" styleClass="section-title"/>
                <VBox spacing="7">
                    <HBox spacing="8" alignment="BOTTOM_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Código de barras" styleClass="field-label"/>
                            <TextField fx:id="codigoField" promptText="Leia ou digite o código"
                                       onAction="#addByBarcode" HBox.hgrow="ALWAYS"/>
                        </VBox>
                        <Button text="Adicionar" onAction="#addByBarcode" styleClass="button, primary"/>
                    </HBox>
                    <HBox spacing="8" alignment="BOTTOM_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Pesquisar no catálogo" styleClass="field-label"/>
                            <TextField fx:id="pesquisaField" promptText="Nome do produto (F2)"
                                       HBox.hgrow="ALWAYS"/>
                        </VBox>
                        <ComboBox fx:id="resultadoCombo" promptText="Selecione um resultado" prefWidth="245"/>
                        <Button text="Incluir selecionado" onAction="#addSelected"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Carrinho com edicao de quantidade, remocao e desconto. -->
            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="1">
                        <Label text="Itens da venda" styleClass="section-title"/>
                        <Label text="Selecione uma linha para alterar ou remover." styleClass="hint"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="quantidadeField" promptText="Quantidade (F4)" prefWidth="130"/>
                    <Button text="Alterar quantidade" onAction="#changeQuantity"/>
                </HBox>
                <TableView fx:id="itensTable" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="Nenhum produto adicionado."/></placeholder>
                    <columns>
                        <TableColumn fx:id="produtoColumn" text="Produto" prefWidth="360"/>
                        <TableColumn fx:id="quantidadeColumn" text="Quantidade" prefWidth="100"/>
                        <TableColumn fx:id="unitarioColumn" text="Unitário" prefWidth="120"/>
                        <TableColumn fx:id="subtotalColumn" text="Subtotal" prefWidth="125"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <Button text="Remover item" onAction="#removeSelected"/>
                    <Button text="Limpar carrinho" onAction="#clearCart" styleClass="button, ghost"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="descontoField" promptText="Desconto (F6)" prefWidth="135"/>
                    <Button text="Aplicar desconto" onAction="#applyDiscount"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Resumo financeiro e componente de pagamentos. -->
        <VBox spacing="10" prefWidth="350" minWidth="330" maxWidth="380">
            <VBox styleClass="card, total-card">
                <Label text="RESUMO DA VENDA" styleClass="section-eyebrow"/>
                <HBox spacing="8">
                    <VBox HBox.hgrow="ALWAYS" styleClass="metric-card">
                        <Label text="SUBTOTAL" styleClass="metric-label"/>
                        <Label fx:id="subtotalLabel" styleClass="metric-value"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="metric-card">
                        <Label text="DESCONTO" styleClass="metric-label"/>
                        <Label fx:id="descontoLabel" styleClass="metric-value"/>
                    </VBox>
                </HBox>
                <Label text="TOTAL A RECEBER" styleClass="metric-label"/>
                <Label fx:id="totalLabel" styleClass="total-value"/>
            </VBox>
            <VBox VBox.vgrow="ALWAYS" styleClass="card">
                <fx:include fx:id="pagamentoPane" source="pagamento-view.fxml"/>
            </VBox>
            <Label text="Atalhos: F2 pesquisar | F4 quantidade | Delete remover | F6 desconto | F10 pagamento | Esc cancelar entrada"
                   wrapText="true" styleClass="shortcut-banner"/>
        </VBox>
    </HBox>
</VBox>
