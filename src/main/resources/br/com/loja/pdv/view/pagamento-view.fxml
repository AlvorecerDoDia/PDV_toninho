<?xml version="1.0" encoding="UTF-8"?>
<!-- Uma unica forma de pagamento por venda. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.loja.pdv.controller.PagamentoController"
      styleClass="payment-panel" VBox.vgrow="ALWAYS">
    <VBox spacing="1">
        <Label text="Recebimento" styleClass="section-title"/>
        <Label text="Escolha uma forma de pagamento para a venda." styleClass="hint"/>
    </VBox>
    <Label fx:id="mensagemLabel" wrapText="true" styleClass="feedback"/>
    <VBox spacing="4">
        <Label text="Forma de pagamento" styleClass="field-label"/>
        <ComboBox fx:id="formaCombo" maxWidth="Infinity"/>
    </VBox>
    <VBox spacing="4">
        <Label text="Valor recebido" styleClass="field-label"/>
        <TextField fx:id="valorField" promptText="0,00"/>
        <Label text="Para PIX e cartão, o valor é preenchido automaticamente."
               wrapText="true" styleClass="field-hint"/>
    </VBox>
    <GridPane hgap="8" vgap="6">
        <Label text="Recebido" styleClass="metric-label"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="recebidoLabel" styleClass="metric-value"
               GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Troco" styleClass="metric-label"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="trocoLabel" styleClass="metric-value"
               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>
    <Region VBox.vgrow="ALWAYS"/>
    <Button text="Finalizar venda (F10)" onAction="#finishSale"
            styleClass="button, success" maxWidth="Infinity"/>
</VBox>
