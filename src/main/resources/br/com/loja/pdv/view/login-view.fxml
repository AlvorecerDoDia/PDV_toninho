<?xml version="1.0" encoding="UTF-8"?>
<!-- Tela simples de acesso ao PDV. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.loja.pdv.controller.LoginController"
            stylesheets="@../css/app.css" styleClass="login-root">
    <left>
        <VBox styleClass="login-brand">
            <Label text="PDV Toninho" styleClass="login-brand-title"/>
            <Label text="Vendas, cadastro, estoque e histórico em um único lugar."
                   wrapText="true" styleClass="login-brand-text"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <center>
        <StackPane styleClass="login-card-wrap">
            <VBox spacing="12" styleClass="card, login-card">
                <VBox spacing="2">
                    <Label text="Bem-vindo" styleClass="login-title"/>
                    <Label text="Entre com seu login e senha." styleClass="page-subtitle"/>
                </VBox>
                <Label fx:id="mensagemLabel" wrapText="true" styleClass="feedback"/>
                <VBox spacing="5">
                    <Label text="Login" styleClass="field-label"/>
                    <TextField fx:id="loginField" promptText="Digite seu login"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Senha" styleClass="field-label"/>
                    <PasswordField fx:id="senhaField" promptText="Digite sua senha"/>
                </VBox>
                <Button text="Entrar" onAction="#login" defaultButton="true"
                        styleClass="button, primary" maxWidth="Infinity"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
