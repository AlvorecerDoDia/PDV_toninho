<?xml version="1.0" encoding="UTF-8"?>
<!-- Caixa simplificado sem suprimento ou sangria manual. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.loja.pdv.controller.CaixaController" styleClass="page-shell">
    <HBox alignment="CENTER_LEFT">
        <VBox styleClass="page-header">
            <Label text="Caixa" styleClass="page-title"/>
            <Label text="Abra o caixa, realize as vendas e confira o fechamento."
                   styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT">
            <Label fx:id="statusLabel" styleClass="balance-chip"/>
            <Label fx:id="esperadoLabel" styleClass="hint"/>
        </VBox>
    </HBox>
    <Label fx:id="mensagemLabel" wrapText="true" styleClass="feedback"/>
    <HBox spacing="12">
        <VBox spacing="9" HBox.hgrow="ALWAYS" styleClass="card">
            <Label text="Abrir caixa" styleClass="section-title"/>
            <Label text="Informe o dinheiro disponível no início do atendimento."
                   wrapText="true" styleClass="hint"/>
            <HBox spacing="8">
                <TextField fx:id="aberturaField" promptText="Valor inicial"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Abrir" onAction="#open" styleClass="button, primary"/>
            </HBox>
        </VBox>
        <VBox spacing="9" HBox.hgrow="ALWAYS" styleClass="card, card-danger">
            <Label text="Fechar caixa" styleClass="section-title"/>
            <Label text="Conte o dinheiro físico e informe o valor encontrado."
                   wrapText="true" styleClass="hint"/>
            <HBox spacing="8">
                <TextField fx:id="contadoField" promptText="Valor contado"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Fechar" onAction="#close" styleClass="button, danger"/>
            </HBox>
        </VBox>
    </HBox>
    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card">
        <HBox alignment="CENTER_LEFT">
            <Label text="Movimentações automáticas" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Atualizar" onAction="#refresh" styleClass="button, ghost"/>
        </HBox>
        <TableView fx:id="movimentacoesTable" VBox.vgrow="ALWAYS">
            <placeholder><Label text="Nenhuma movimentação registrada."/></placeholder>
            <columns>
                <TableColumn fx:id="dataColumn" text="Data" prefWidth="190"/>
                <TableColumn fx:id="tipoColumn" text="Tipo" prefWidth="190"/>
                <TableColumn fx:id="valorColumn" text="Valor" prefWidth="170"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
