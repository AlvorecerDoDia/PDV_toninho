<?xml version="1.0" encoding="UTF-8"?>
<!-- Relatorios com filtros identificados e acoes priorizadas. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.loja.pdv.controller.RelatorioController" styleClass="page-shell">
    <VBox styleClass="page-header">
        <Label text="Relatórios" styleClass="page-title"/>
        <Label text="Escolha o tipo, ajuste os filtros e gere uma visão operacional."
               styleClass="page-subtitle"/>
    </VBox>
    <Label fx:id="mensagemLabel" wrapText="true" styleClass="feedback"/>
    <VBox spacing="9" styleClass="card, card-compact">
        <HBox alignment="CENTER_LEFT">
            <Label text="Filtros do relatório" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Limpar filtros" onAction="#clearFilters" styleClass="button, ghost"/>
        </HBox>
        <FlowPane hgap="9" vgap="8">
            <VBox spacing="4">
                <Label text="Tipo de relatório" styleClass="field-label"/>
                <ComboBox fx:id="tipoCombo" prefWidth="235"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Data inicial" styleClass="field-label"/>
                <DatePicker fx:id="inicioPicker"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Data final" styleClass="field-label"/>
                <DatePicker fx:id="fimPicker"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Operador" styleClass="field-label"/>
                <ComboBox fx:id="operadorCombo" promptText="Todos" prefWidth="175"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Forma de pagamento" styleClass="field-label"/>
                <ComboBox fx:id="formaCombo" promptText="Todas" prefWidth="170"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Produto" styleClass="field-label"/>
                <ComboBox fx:id="produtoCombo" promptText="Todos" prefWidth="210"/>
            </VBox>
        </FlowPane>
        <HBox spacing="8">
            <Button text="Gerar relatório" onAction="#generate" styleClass="button, primary"/>
            <Button text="Exportar resultado em CSV" onAction="#exportCsv"/>
        </HBox>
    </VBox>
    <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="card">
        <Label text="Resultado" styleClass="section-title"/>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
            <placeholder><Label text="Gere um relatório para ver os dados."/></placeholder>
            <columns>
                <TableColumn fx:id="categoriaColumn" text="Categoria" prefWidth="200"/>
                <TableColumn fx:id="detalheColumn" text="Detalhe" prefWidth="320"/>
                <TableColumn fx:id="quantidadeColumn" text="Quantidade" prefWidth="100"/>
                <TableColumn fx:id="valorColumn" text="Valor" prefWidth="125"/>
                <TableColumn fx:id="valor2Column" text="Valor adicional" prefWidth="130"/>
                <TableColumn fx:id="dataColumn" text="Data" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
