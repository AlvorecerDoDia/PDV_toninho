<?xml version="1.0" encoding="UTF-8"?>
<!-- Cadastro simples de usuarios locais. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.loja.pdv.controller.UsuarioController" styleClass="page-shell">
    <VBox styleClass="page-header">
        <Label text="Usuários" styleClass="page-title"/>
        <Label text="Cadastre as pessoas que podem entrar no sistema."
               styleClass="page-subtitle"/>
    </VBox>
    <Label fx:id="mensagemLabel" wrapText="true" styleClass="feedback"/>
    <SplitPane dividerPositions="0.38" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="10" styleClass="card">
                <Label text="Dados de acesso" styleClass="section-title"/>
                <VBox spacing="4">
                    <Label text="Nome" styleClass="field-label"/>
                    <TextField fx:id="nomeField" promptText="Nome completo"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Login" styleClass="field-label"/>
                    <TextField fx:id="loginField" promptText="Login para entrar"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Senha" styleClass="field-label"/>
                    <PasswordField fx:id="senhaField" promptText="Mínimo de 4 caracteres"/>
                    <Label text="Na edição, deixe vazio para manter a senha atual."
                           styleClass="field-hint"/>
                </VBox>
                <CheckBox fx:id="ativoCheck" text="Usuário ativo" selected="true"/>
                <HBox spacing="8">
                    <Button text="Salvar" onAction="#save" styleClass="button, primary"/>
                    <Button text="Limpar" onAction="#clear" styleClass="button, ghost"/>
                </HBox>
            </VBox>
            <VBox spacing="8" styleClass="card">
                <Label text="Usuários cadastrados" styleClass="section-title"/>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                    <placeholder><Label text="Nenhum usuário cadastrado."/></placeholder>
                    <columns>
                        <TableColumn fx:id="nomeColumn" text="Nome" prefWidth="280"/>
                        <TableColumn fx:id="loginColumn" text="Login" prefWidth="190"/>
                        <TableColumn fx:id="statusColumn" text="Situação" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </items>
    </SplitPane>
</VBox>
