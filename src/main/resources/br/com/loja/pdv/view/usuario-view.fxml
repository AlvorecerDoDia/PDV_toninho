<?xml version="1.0" encoding="UTF-8"?>
<!-- Gestão de usuários, perfis, situação e redefinição de senha. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.loja.pdv.controller.UsuarioController">
    <top><VBox spacing="8"><padding><Insets top="16" right="16" bottom="8" left="16"/></padding>
        <Label text="Usuários e permissões" styleClass="page-title"/>
        <Label fx:id="mensagemLabel"/>
    </VBox></top>
    <left><GridPane hgap="10" vgap="10" prefWidth="390"><padding><Insets top="8" right="16" bottom="16" left="16"/></padding>
        <Label text="Nome" GridPane.rowIndex="0"/><TextField fx:id="nomeField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Login" GridPane.rowIndex="1"/><TextField fx:id="loginField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Senha" GridPane.rowIndex="2"/><PasswordField fx:id="senhaField" promptText="Obrigatória no cadastro" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Perfil" GridPane.rowIndex="3"/><ComboBox fx:id="perfilCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <CheckBox fx:id="ativoCheck" text="Usuário ativo" selected="true" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
        <HBox spacing="8" GridPane.rowIndex="5" GridPane.columnSpan="2">
            <Button text="Salvar" onAction="#save" styleClass="button, primary"/>
            <Button text="Limpar" onAction="#clear"/>
        </HBox>
    </GridPane></left>
    <center><TableView fx:id="tabela"><columns>
        <TableColumn fx:id="nomeColumn" text="Nome" prefWidth="220"/>
        <TableColumn fx:id="loginColumn" text="Login" prefWidth="150"/>
        <TableColumn fx:id="perfilColumn" text="Perfil" prefWidth="150"/>
        <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
    </columns><BorderPane.margin><Insets top="8" right="16" bottom="16" left="0"/></BorderPane.margin></TableView></center>
</BorderPane>
