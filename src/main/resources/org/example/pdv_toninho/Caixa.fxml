<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="768.0" prefWidth="1024.0" styleClass="raiz-pdv" stylesheets="@../../../css/caixa.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="menu-superior">
        <Label styleClass="texto-branco-negrito" text="Caixa" />

        <Label styleClass="texto-atalho" text=" Produtos (F1)" />
        <Label styleClass="texto-atalho" text="👤 Cliente (F2)" />
        <Label styleClass="texto-atalho" text="🏷️ Desconto (F4)" />
        <Label styleClass="texto-atalho" text="✖ Cancelar (F8)" />
        <Label styleClass="texto-atalho" text="⌨ Quantidade (F9)" />
        <Label styleClass="texto-atalho" text="⏻ Fechar caixa" />

        <Region HBox.hgrow="ALWAYS" />
        <Button styleClass="btn-adm" text="ADM" />
    </HBox>

    <HBox alignment="CENTER_LEFT" styleClass="barra-consumidor">
        <Label style="-fx-font-size: 16px;" styleClass="texto-branco-negrito" text="🛒 Consumidor" />
        <Region HBox.hgrow="ALWAYS" />
        <Button styleClass="btn-finalizar-verde" text="✔ Finalizar Venda (F10)   R$ 0,00" />
    </HBox>

    <TableView fx:id="tabelaProdutos" styleClass="tabela-produtos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn prefWidth="500.0" text="Produto" />
            <TableColumn prefWidth="150.0" text="Qtd" />
            <TableColumn prefWidth="200.0" text="Subtotal" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="15.0" styleClass="rodape-totais">

        <VBox alignment="CENTER" maxWidth="Infinity" styleClass="cartao-branco" HBox.hgrow="ALWAYS">
            <Label styleClass="titulo-cartao-escuro" text="Itens" />
            <Label styleClass="valor-cartao-escuro" text="0 unidade(s)" />
        </VBox>

        <VBox alignment="CENTER" maxWidth="Infinity" styleClass="cartao-branco" HBox.hgrow="ALWAYS">
            <Label styleClass="titulo-cartao-escuro" text="Subtotal R$" />
            <Label styleClass="valor-cartao-escuro" text="R$ 0,00" />
        </VBox>

        <VBox alignment="CENTER" maxWidth="Infinity" styleClass="cartao-desconto" HBox.hgrow="ALWAYS">
            <Label styleClass="titulo-cartao-claro" text="Descontos R$" />
            <Label styleClass="valor-cartao-claro" text="R$ 0,00" />
        </VBox>

        <VBox alignment="CENTER" maxWidth="Infinity" styleClass="cartao-total" HBox.hgrow="ALWAYS">
            <Label styleClass="titulo-cartao-claro" text="TOTAL R$" />
            <Label styleClass="valor-total-gigante" text="R$ 0,00" />
        </VBox>

    </HBox>
</VBox>
