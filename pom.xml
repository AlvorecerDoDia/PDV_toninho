<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Identidade usada pelo Maven para nomear o artefato gerado. -->
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.loja</groupId>
    <artifactId>pdv-loja</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- Versoes centralizadas evitam divergencia entre plugins e dependencias. -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <javafx.version>21.0.10</javafx.version>
        <sqlite.version>3.53.2.0</sqlite.version>
        <junit.version>5.12.2</junit.version>
    </properties>

    <!-- Bibliotecas necessarias em execucao e durante os testes. -->
    <dependencies>
        <!-- Controles visuais como campos, botoes, tabelas e paineis. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Carregamento dos arquivos FXML e injecao dos controllers. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Driver JDBC que permite abrir o banco SQLite local. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Framework usado por todos os testes automatizados. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Plugins que compilam, testam, executam e empacotam a aplicacao. -->
    <build>
        <finalName>pdv-toninho</finalName>
        <plugins>
            <!-- Define o manifesto do JAR usado pelo processo de distribuicao. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>br.com.loja.pdv.PdvLauncher</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Compila todo o codigo usando a versao definida de Java. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <!-- Executa a classe principal com os modulos JavaFX corretos. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>br.com.loja.pdv.PdvLauncher</mainClass>
                </configuration>
            </plugin>

            <!-- Descobre e executa a suite JUnit durante test e package. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>

            <!-- Copia as dependencias de execucao usadas pelo script do jpackage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
        </plugins>
    </build>

</project>
